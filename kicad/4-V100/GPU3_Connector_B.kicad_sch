(text "NVLink data pins connect through matching global labels. Clock, ground, power and control contacts keep their names and remain unconnected." (at 17 16 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "310d8d0e-7a11-51ec-b454-7c9edfdbcf64"))
(text "DATA WIRING ONLY - EXTERNAL CLOCK REQUIRED\nEach V100: 156.25 MHz differential NVHS clock on B/E20 (P) and B/F20 (N). Clock circuitry is not included." (at 17 28 0) (effects (font (size 1.778 1.778)) (justify left)) (uuid "1a8e2198-8e8a-597d-8d1a-7d7d8838e387"))
